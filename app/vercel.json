{
  "functions": {
    "api/competitive-programming.ts": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/skills", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/projects/(.*)", "destination": "/index.html" },
    { "source": "/competitive-programming", "destination": "/index.html" },
    { "source": "/experience", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/learning", "destination": "/index.html" },
    { "source": "/articles", "destination": "/index.html" },
    { "source": "/resume", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
